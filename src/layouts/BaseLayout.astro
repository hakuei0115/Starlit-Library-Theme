---
import { getImage } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: string;
  lang?: string;
}

const {
  title,
  description = siteConfig.description,
  image,
  articleDate,
  lang = siteConfig.lang,
} = Astro.props;

const siteTitle = siteConfig.title;
const fullTitle = title ? `${title} — ${siteTitle}` : `${siteTitle} — ${siteConfig.subtitle}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
// Share image: the page's own image, otherwise a 1200×630 JPG made from the site artwork
// (many social platforms do not show SVG previews).
const shareImage =
  image ??
  (await getImage({
    src: siteConfig.art.ogImage ?? siteConfig.art.heroBanner,
    width: 1200,
    height: 630,
    fit: 'cover',
    format: 'jpg',
  })).src;
const imageURL = new URL(shareImage, Astro.site || Astro.url.origin);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS Feed`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    {articleDate && <meta property="article:published_time" content={articleDate} />}

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageURL} />

    <slot name="head" />
  </head>
  <body>
    <!-- Skip to content link for keyboard accessibility -->
    <a href="#main-content" class="skip-to-content">
      跳至主要內容 / Skip to content
    </a>

    <!-- Header Navigation -->
    <SiteHeader />

    <!-- Main Content Area -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <!-- Footer -->
    <SiteFooter />
  </body>
</html>

<style>
  #main-content {
    outline: none;
    flex: 1 0 auto;
  }
</style>
