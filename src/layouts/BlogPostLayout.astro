---
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';
import ArticleCompanion from '../components/blog/ArticleCompanion.astro';
import CodeCopy from '../components/common/CodeCopy.astro';
import ScrollableFocus from '../components/common/ScrollableFocus.astro';

interface Props {
  title: string;
  description?: string;
  pubDate?: Date | string;
  updatedDate?: Date | string;
  cover?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  cover
} = Astro.props;

const formattedDate = pubDate ? new Date(pubDate).toISOString() : undefined;
const modifiedDate = updatedDate ? new Date(updatedDate).toISOString() : undefined;
---

<BaseLayout
  title={title}
  description={description}
  image={cover}
  articleDate={formattedDate}
  modifiedDate={modifiedDate}
>
  <div class="article-layout container-site">
    <div class="article-grid">
      <!-- Main Content Column -->
      <article class="article-main">
        <header class="article-header-slot">
          <slot name="header" />
        </header>

        <!-- Mobile Table of Contents slot (< 1024px) -->
        <div class="article-toc-mobile">
          <slot name="toc-mobile" />
        </div>

        <!-- Article Prose Body -->
        <div class="article-prose container-prose">
          <slot />
        </div>

        <!-- Article Footer (Tags, Prev/Next) -->
        <footer class="article-footer-slot">
          <slot name="footer" />
        </footer>

        <!-- Mobile Reading Companion Slot (< 1024px, after footer) -->
        <div class="article-companion-mobile">
          <slot name="companion-mobile">
            <slot name="mobile-companion">
              <ArticleCompanion />
            </slot>
          </slot>
        </div>
      </article>

      <!-- Desktop Sticky Sidebar (>= 1024px) -->
      <aside class="article-sidebar" aria-label="文章目錄與閱讀陪伴">
        <div class="sidebar-sticky-wrapper">
          <!-- Desktop TOC Slot (Flexible & scrollable when list is tall) -->
          <div class="sidebar-toc-container">
            <slot name="toc" />
          </div>

          <!-- Desktop Compact Companion Slot (Docked below TOC) -->
          <div class="sidebar-companion-container">
            <slot name="sidebar-companion">
              <slot name="companion">
                <ArticleCompanion />
              </slot>
            </slot>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <CodeCopy />
  <ScrollableFocus />
</BaseLayout>

<script>
  // Sticky only while the companion plus a usable part of the TOC fit below the header.
  function setupSidebar() {
    const wrapper = document.querySelector<HTMLElement>('.sidebar-sticky-wrapper');
    const companion = wrapper?.querySelector<HTMLElement>('.sidebar-companion-container');
    const toc = wrapper?.querySelector<HTMLElement>('.sidebar-toc-container');
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!wrapper || !companion || !toc || !header) return;

    function update() {
      if (!wrapper || !companion || !toc || !header || !wrapper.offsetParent) return;
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
      const available = window.innerHeight - header.offsetHeight - 2 * rem;
      const nav = toc.querySelector<HTMLElement>('.toc-nav');
      const list = nav?.querySelector<HTMLElement>('.toc-list');
      // TOC card without its list, plus at least 8rem of the list (or all of a shorter one).
      const tocNeeded = nav && list ? toc.offsetHeight - nav.offsetHeight + Math.min(list.scrollHeight, 8 * rem) : 0;
      wrapper.classList.toggle('is-static', tocNeeded + rem + companion.offsetHeight > available);
    }

    const observer = new ResizeObserver(update);
    observer.observe(companion);
    observer.observe(header);
    observer.observe(document.documentElement);
    window.addEventListener('resize', update);
    update();
  }

  setupSidebar();
  document.addEventListener('astro:after-swap', setupSidebar);
</script>

<style>
  .article-layout {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
    width: 100%;
    box-sizing: border-box;
  }

  /* Responsive Grid: Single column < 1024px, 2 columns >= 1024px */
  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    width: 100%;
    box-sizing: border-box;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: minmax(0, 1fr) var(--container-toc);
      column-gap: var(--space-10);
      align-items: stretch;
    }
  }

  .article-main {
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .article-header-slot {
    margin-bottom: var(--space-8);
  }

  /* Mobile TOC slot (< 1024px) */
  .article-toc-mobile {
    display: block;
    margin-bottom: var(--space-8);
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 1024px) {
    .article-toc-mobile {
      display: none;
    }
  }

  /* Prose container adhering to --container-prose (~736px) */
  .article-prose {
    font-size: var(--text-article);
    line-height: 1.9;
    color: var(--color-text);
    width: 100%;
    max-width: var(--container-prose);
    box-sizing: border-box;
  }

  .article-footer-slot {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: var(--border-thin);
    width: 100%;
    box-sizing: border-box;
  }

  /* Mobile Companion: shown only below 1024px, after footer */
  .article-companion-mobile {
    display: block;
    margin-top: var(--space-8);
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 1024px) {
    .article-companion-mobile {
      display: none;
    }
  }

  /* Desktop Sidebar (>= 1024px) */
  .article-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .article-sidebar {
      display: block;
      width: var(--container-toc);
      max-width: var(--container-toc);
      min-width: 0;
      box-sizing: border-box;
      align-self: stretch;
    }

    /* Sticky Wrapper with Height Budget for TOC and Companion */
    .sidebar-sticky-wrapper {
      position: sticky;
      top: calc(var(--header-height) + var(--space-4));
      max-height: calc(100vh - var(--header-height) - var(--space-8));
      max-height: calc(100dvh - var(--header-height) - var(--space-8));
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      box-sizing: border-box;
    }

    /* The TOC takes what the companion leaves; only its list scrolls. */
    .sidebar-toc-container {
      flex: 0 1 auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    .sidebar-companion-container {
      flex-shrink: 0;
    }

    /* When both cards cannot fit, they stay in normal document flow. The class is set by
       the script above; the media query covers short windows without JavaScript. */
    .sidebar-sticky-wrapper.is-static {
      position: static;
      max-height: none;
    }

    @media (max-height: 32rem) {
      .sidebar-sticky-wrapper {
        position: static;
        max-height: none;
      }
    }
  }
</style>
