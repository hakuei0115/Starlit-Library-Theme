---
/**
 * MascotPortrait.astro
 *
 * Mascot reading companion (3:4 portrait artwork) with an optional speech message.
 * Follows docs/design/page-layout-spec.md v1.1 and mascot-spec.md.
 * Until more poses are delivered, every variant uses the "hugging a book" artwork.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultArt from '../../assets/petit-hugging-book.png';

interface Props {
  variant?: 'reading' | 'thinking';
  size?: 'sm' | 'md' | 'lg';
  message?: string;
  /** Artwork override (3:4 portrait). Defaults to the hugging-book pose. */
  src?: ImageMetadata;
  alt?: string;
  class?: string;
}

const {
  variant = 'reading',
  size = 'md',
  message,
  src = defaultArt,
  alt = '館員抱著書的插圖',
  class: className = '',
} = Astro.props;

// Rendered width of the artwork for each size, so the browser downloads no more than needed.
const SIZE_PX = { sm: 160, md: 240, lg: 320 } as const;
---

<div class:list={['mascot-portrait', `size-${size}`, `variant-${variant}`, className]}>
  <Image
    class="mascot-portrait-art"
    src={src}
    alt={alt}
    widths={[160, 240, 320, 480, 640]}
    sizes={`(min-width: 640px) ${SIZE_PX[size]}px, min(${SIZE_PX[size]}px, 100vw)`}
    format="webp"
    quality={80}
    loading="lazy"
    decoding="async"
  />

  <!-- Optional Speech Message -->
  {message && (
    <div class="companion-bubble" role="note">
      <svg class="bubble-star" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" fill="var(--color-gold)" />
      </svg>
      <p class="bubble-text">{message}</p>
    </div>
  )}
</div>

<style>
  .mascot-portrait {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .size-sm {
    max-width: 160px;
  }
  .size-md {
    max-width: 240px;
  }
  .size-lg {
    max-width: 320px;
  }

  .mascot-portrait-art {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: contain;
    border-radius: var(--radius-lg);
  }

  /* Optional Companion Bubble */
  .companion-bubble {
    position: relative;
    background-color: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: var(--space-2) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .companion-bubble::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%);
    border-width: 0 6px 6px 6px;
    border-style: solid;
    border-color: transparent transparent var(--color-border) transparent;
  }

  .bubble-star {
    flex-shrink: 0;
  }

  .bubble-text {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text);
    line-height: 1.5;
  }
</style>
