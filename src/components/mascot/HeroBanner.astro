---
/**
 * HeroBanner.astro
 *
 * Full-width responsive Hero banner for Starlit Library Theme.
 * Follows docs/design/page-layout-spec.md:
 * - Full-width inside the site container (not divided into columns)
 * - Aspect ratio: ~2.4:1 on desktop (>=768px), 16:9 on mobile (<768px)
 * - Artwork comes from `siteConfig.art` (src/site.config.ts)
 */

import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { siteConfig } from '../../site.config';

interface Props {
  src: ImageMetadata;
  /** Optional 16:9 variant served below 768px; falls back to `src`. */
  mobileSrc?: ImageMetadata;
  alt?: string;
  class?: string;
}

const {
  src,
  mobileSrc,
  alt = siteConfig.hero.bannerAlt,
  class: className = '',
} = Astro.props;

// The hero is the LCP element: serve WebP at several widths and let the browser pick.
const build = (img: ImageMetadata, widths: number[]) =>
  getImage({ src: img, widths, format: 'webp', quality: 80 });
const desktop = await build(src, [768, 1200, 1600, 1942]);
const mobile = mobileSrc ? await build(mobileSrc, [480, 720, 960, 1280]) : undefined;
const srcset = (img: Awaited<ReturnType<typeof getImage>>) => img.srcSet.attribute;
---

<div class:list={['hero-banner-container', className]}>
  <picture>
      {mobile && mobileSrc && (
        <source
          media="(max-width: 767px)"
          srcset={srcset(mobile)}
          sizes="100vw"
          type="image/webp"
          width={mobileSrc.width}
          height={mobileSrc.height}
        />
      )}
      <img
        src={desktop.src}
        srcset={srcset(desktop)}
        sizes="(min-width: 1280px) 1200px, 100vw"
        alt={alt}
        class="hero-banner-img"
        width={src.width}
        height={src.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
</div>

<style>
  .hero-banner-container {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    border: var(--border-thin);
  }

  .hero-banner-img {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .hero-banner-img {
      aspect-ratio: 2.4 / 1;
    }
  }
</style>
