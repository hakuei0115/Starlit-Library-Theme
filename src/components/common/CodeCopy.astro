---
import { t } from '../../i18n/ui';
// Adds a "copy" button to every code block inside `.article-prose`.
// Without JavaScript no button is shown and the code stays selectable as usual.
---

<span
  id="code-copy-status"
  class="sr-only"
  role="status"
  aria-live="polite"
  data-copy={t.code.copy}
  data-copied={t.code.copied}
  data-failed={t.code.failed}
  data-copied-status={t.code.copiedStatus}
  data-failed-status={t.code.failedStatus}></span>

<script>
  const RESET_AFTER_MS = 2000;

  function setupCodeCopy() {
    // The labels come from the interface dictionary, through the element above.
    const status = document.getElementById('code-copy-status');
    if (!status) return;
    const text = status.dataset;

    document.querySelectorAll<HTMLPreElement>('.article-prose pre').forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-block')) return;

      // The button sits outside <pre>, so it stays put when long lines scroll sideways.
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.replaceWith(wrapper);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy-button';
      button.textContent = text.copy ?? '';
      wrapper.append(button, pre);

      let timer: number | undefined;
      button.addEventListener('click', async () => {
        const code = (pre.querySelector('code') ?? pre).textContent ?? '';
        let copied = true;
        try {
          await navigator.clipboard.writeText(code.replace(/\n$/, ''));
        } catch {
          // Clipboard access can be refused, and is unavailable on plain http.
          copied = false;
        }

        button.textContent = (copied ? text.copied : text.failed) ?? '';
        status.textContent = (copied ? text.copiedStatus : text.failedStatus) ?? '';

        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          button.textContent = text.copy ?? '';
          status.textContent = '';
        }, RESET_AFTER_MS);
      });
    });
  }

  setupCodeCopy();
  document.addEventListener('astro:page-load', setupCodeCopy);
</script>

<style is:global>
  .code-block {
    position: relative;
    margin-bottom: var(--space-6);
  }

  /* Extra top padding keeps the button clear of the first line of code. */
  .article-prose .code-block > pre {
    margin-bottom: 0;
    padding-top: var(--space-12);
  }

  .code-copy-button {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    min-width: 4rem;
    min-height: 2rem;
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    line-height: 1.4;
    color: var(--color-code-text);
    background: var(--color-code-bg);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color var(--motion-fast) var(--ease-soft);
  }

  .code-copy-button:hover {
    border-color: var(--color-gold);
  }

  /* The default focus color is too dark to see on the code background. */
  .code-copy-button:focus-visible {
    outline-color: var(--color-gold);
    outline-offset: 2px;
  }
</style>
