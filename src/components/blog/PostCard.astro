---
import { t } from '../../i18n/ui';
import { siteConfig } from '../../site.config';
import { tagUrl } from '../../utils/tags';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post?: CollectionEntry<'blog'>;
  title?: string;
  description?: string;
  pubDate?: Date | string;
  category?: string;
  tags?: string[];
  slug?: string;
  id?: string;
  readingTime?: string;
  featured?: boolean;
}

const {
  post,
  title = post?.data.title ?? '',
  description = post?.data.description ?? '',
  pubDate = post?.data.pubDate,
  category = post?.data.category ?? 'General',
  tags = post?.data.tags ?? [],
  slug = post?.id,
  id = post?.id,
  readingTime,
  featured = post?.data.featured ?? false,
} = Astro.props;

const postSlug = slug || id || '';
const postUrl = `/posts/${postSlug}/`;

const dateObj = pubDate ? new Date(pubDate) : null;
const isoDate = dateObj ? dateObj.toISOString() : '';
const displayDate = dateObj
  ? new Intl.DateTimeFormat(siteConfig.lang, {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(dateObj)
  : '';
---

<article class={`post-card ${featured ? 'post-card--featured' : ''}`}>
  <div class="post-card__header">
    <span class="post-card__category">{category}</span>
    {dateObj && (
      <time datetime={isoDate} class="post-card__date">
        <svg class="post-card__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        {displayDate}
      </time>
    )}
  </div>

  <h3 class="post-card__title">
    <a href={postUrl} class="post-card__title-link">
      {title}
    </a>
  </h3>

  {description && (
    <p class="post-card__excerpt">
      {description}
    </p>
  )}

  <div class="post-card__footer">
    {tags.length > 0 && (
      <ul class="post-card__tags" aria-label={t.common.articleTags}>
        {tags.map((tag) => (
          <li class="post-card__tag">
            <a href={tagUrl(tag)}>#{tag}</a>
          </li>
        ))}
      </ul>
    )}
    {readingTime && (
      <span class="post-card__reading-time">
        <svg class="post-card__icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        {readingTime}
      </span>
    )}
  </div>
</article>

<style>
  .post-card {
    display: flex;
    min-width: 0;
    overflow-wrap: anywhere;
    flex-direction: column;
    background-color: var(--color-surface, #ffffff);
    border: var(--border-thin, 1px solid var(--color-border, #e2d8e3));
    border-radius: var(--radius-lg, 1rem);
    box-shadow: var(--shadow-card, 0 4px 16px rgba(48, 43, 64, 0.06));
    padding: var(--space-6, 1.5rem);
    transition: transform var(--motion-normal, 220ms) var(--ease-soft, cubic-bezier(0.22, 1, 0.36, 1)),
                box-shadow var(--motion-normal, 220ms) var(--ease-soft, cubic-bezier(0.22, 1, 0.36, 1)),
                border-color var(--motion-normal, 220ms) var(--ease-soft, cubic-bezier(0.22, 1, 0.36, 1));
    position: relative;
    height: 100%;
  }

  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover, 0 10px 30px rgba(48, 43, 64, 0.10));
    border-color: var(--color-accent, #8a83aa);
  }

  .post-card--featured {
    border-left: 3px solid var(--color-gold, #d5bf9b);
  }

  .post-card__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2, 0.5rem);
    margin-bottom: var(--space-3, 0.75rem);
  }

  .post-card__category {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.65rem;
    font-size: var(--text-small, 0.8125rem);
    font-weight: 500;
    color: var(--color-night, #302b40);
    background-color: var(--color-surface-alt, #edeaf6);
    border-radius: var(--radius-pill, 9999px);
    letter-spacing: 0.02em;
  }

  .post-card__date {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-small, 0.8125rem);
    color: var(--color-text-muted, #716a7b);
  }

  .post-card__icon {
    flex-shrink: 0;
    opacity: 0.75;
  }

  .post-card__title {
    font-size: var(--text-h3, 1.25rem);
    font-weight: 650;
    line-height: 1.4;
    margin: 0 0 var(--space-3, 0.75rem) 0;
    color: var(--color-text, #524b5a);
  }

  .post-card__title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--motion-fast, 140ms) ease;
  }

  .post-card__title-link:hover {
    color: var(--color-night, #302b40);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-accent, #8a83aa);
  }

  .post-card__title-link:focus-visible {
    outline: 2px solid var(--color-focus, #524b5a);
    outline-offset: 3px;
    border-radius: var(--radius-sm, 0.375rem);
  }

  .post-card__excerpt {
    font-size: var(--text-small, 0.9375rem);
    line-height: 1.65;
    color: var(--color-text-muted, #716a7b);
    margin: 0 0 var(--space-5, 1.25rem) 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .post-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
    margin-top: auto;
    padding-top: var(--space-3, 0.75rem);
    border-top: 1px dashed var(--color-border, #e2d8e3);
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-card__tag {
    font-size: var(--text-caption, 0.75rem);
    margin: 0;
  }

  .post-card__tag a {
    display: inline-block;
    color: var(--color-text-muted);
    background-color: var(--color-bg);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .post-card__tag a:hover {
    color: var(--color-night);
    background-color: var(--color-surface-alt);
  }

  .post-card__reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--text-caption, 0.75rem);
    color: var(--color-text-muted, #716a7b);
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card {
      transition: none;
    }
    .post-card:hover {
      transform: none;
    }
  }
</style>
