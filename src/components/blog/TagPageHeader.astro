---
import { siteConfig } from '../../site.config';

interface Props {
  title: string;
  description: string;
  /** Show a link back to the tag index (for single-tag pages). */
  showIndexCrumb?: boolean;
}

const { title, description, showIndexCrumb = false } = Astro.props;
---

<header class="tag-header">
  <nav class="tag-breadcrumb" aria-label="路徑導覽">
    <ol>
      <li><a href="/">首頁</a></li>
      <li aria-hidden="true">/</li>
      {showIndexCrumb && (
        <>
          <li><a href="/tags/">{siteConfig.tags.title}</a></li>
          <li aria-hidden="true">/</li>
        </>
      )}
      <li class="current" aria-current="page">{title}</li>
    </ol>
  </nav>

  <h1>{title}</h1>
  <p>{description}</p>
</header>

<style>
  .tag-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-10) var(--page-gutter);
    text-align: center;
    background: var(--color-surface-veil);
    border-bottom: var(--border-thin);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  li {
    margin: 0;
  }

  a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-night);
    text-decoration: underline;
  }

  .current {
    color: var(--color-text);
    font-weight: 500;
  }

  h1 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-h1);
    line-height: 1.25;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  p {
    margin: 0;
    font-size: var(--text-article);
    color: var(--color-text-muted);
  }
</style>
