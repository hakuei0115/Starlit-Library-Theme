---
import { t } from '../../i18n/ui';
import type { Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';
import MascotPortrait from '../mascot/MascotPortrait.astro';
import { siteConfig } from '../../site.config';
import { getPublishedPosts, type BlogPost } from '../../utils/posts';
import { categoryUrl, collectCategories } from '../../utils/categories';
import { slugify } from '../../utils/slug';

interface Props {
  page: Page<BlogPost>;
  /** Set on category pages. */
  category?: string;
}

const { page, category } = Astro.props;
const { articles: copy } = siteConfig;

const allPosts = await getPublishedPosts();
const categories = collectCategories(allPosts);
const activeSlug = category ? slugify(category) : null;

const heading = category ?? copy.title;
const title = t.list.pageTitle(
  category ? t.list.categoryTitle(category, copy.title) : copy.title,
  page.currentPage,
);
const description = category ? t.list.categoryDescription(category) : copy.description;
const baseUrl = category ? categoryUrl(category) : '/articles/';
---

<BaseLayout title={title} description={description}>
  <div class="articles-page">
    <header class="articles-header">
      <div class="header-container">
        <nav class="breadcrumb-nav" aria-label={t.common.breadcrumb}>
          <ol class="breadcrumb-list">
            <li class="breadcrumb-item"><a href="/" class="breadcrumb-link">{t.common.home}</a></li>
            <li class="breadcrumb-sep" aria-hidden="true">/</li>
            {category ? (
              <>
                <li class="breadcrumb-item"><a href="/articles/" class="breadcrumb-link">{copy.title}</a></li>
                <li class="breadcrumb-sep" aria-hidden="true">/</li>
                <li class="breadcrumb-item breadcrumb-current" aria-current="page">{category}</li>
              </>
            ) : (
              <li class="breadcrumb-item breadcrumb-current" aria-current="page">{copy.title}</li>
            )}
          </ol>
        </nav>

        <div class="header-badge">
          <span class="star-icon" aria-hidden="true">✦</span>
          <span>{t.list.eyebrow}</span>
        </div>
        <h1 class="articles-title">{heading}</h1>
        <p class="articles-lead">
          {description}{t.list.countBefore}
          <span class="count-badge">{page.total}</span>
          {t.list.countAfter(page.total)}
        </p>
      </div>
    </header>

    <div class="articles-content container-site">
      <!-- Category Filter Bar -->
      <section class="filter-section" aria-label={t.list.filter}>
        <div class="filter-bar">
          <span class="filter-label">{t.list.filterLabel}</span>
          <div class="filter-chips">
            <a
              href="/articles/"
              class:list={['filter-chip', { active: !category }]}
              aria-current={!category && page.currentPage === 1 ? 'page' : undefined}
            >
              {t.common.allArticles} ({allPosts.length})
            </a>
            {categories.map((cat) => (
              <a
                href={categoryUrl(cat.name)}
                class:list={['filter-chip', { active: cat.slug === activeSlug }]}
                aria-current={cat.slug === activeSlug && page.currentPage === 1 ? 'page' : undefined}
                data-category={cat.name}
              >
                <span class="chip-dot" aria-hidden="true"></span>
                <span>{cat.name}</span>
                <span class="chip-count">({cat.posts.length})</span>
              </a>
            ))}
          </div>
        </div>
        <a href="/tags/" class="all-tags-link">{t.list.allTags} →</a>
      </section>

      <!-- Articles Grid -->
      <section class="articles-grid-section" aria-label={t.list.list}>
        <h2 class="sr-only">{t.common.articles}</h2>
        <div class="articles-grid">
          {page.data.map((post) => (
            <div class="article-item">
              <PostCard post={post} />
            </div>
          ))}
        </div>

        {page.total === 0 && (
          <div class="articles-empty">
            <MascotPortrait variant="thinking" size="md" message={copy.emptyMessage} />
          </div>
        )}

        <Pagination currentPage={page.currentPage} lastPage={page.lastPage} baseUrl={baseUrl} />
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  // Old links used /articles?category=Name; send them to the category page.
  const wanted = new URLSearchParams(window.location.search).get('category');
  if (wanted) {
    const link = [...document.querySelectorAll<HTMLAnchorElement>('.filter-chip[data-category]')].find(
      (chip) => chip.dataset.category === wanted,
    );
    if (link) window.location.replace(link.href);
  }
</script>

<style>
  .articles-page {
    width: 100%;
    padding-bottom: var(--space-16);
  }

  .articles-header {
    background: var(--color-surface-veil);
    border-bottom: var(--border-thin);
    padding: var(--space-10) var(--page-gutter);
    text-align: center;
  }

  .header-container {
    max-width: var(--container-prose);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .breadcrumb-nav {
    margin-bottom: var(--space-4);
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .breadcrumb-link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-soft);
  }

  .breadcrumb-link:hover {
    color: var(--color-night);
    text-decoration: underline;
  }

  .breadcrumb-sep {
    color: var(--color-lavender);
    user-select: none;
  }

  .breadcrumb-current {
    color: var(--color-text);
    font-weight: 500;
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: var(--space-2);
  }

  .star-icon {
    color: var(--color-gold);
  }

  .articles-title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    color: var(--color-text);
    margin: 0 0 var(--space-3) 0;
    line-height: 1.2;
  }

  .articles-lead {
    font-size: var(--text-article);
    line-height: 1.8;
    color: var(--color-text-muted);
    margin: 0;
  }

  .count-badge {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    background: var(--color-surface-alt);
    border-radius: var(--radius-sm);
    color: var(--color-night);
    font-weight: 600;
    font-family: var(--font-code);
  }

  .articles-content {
    margin: 0 auto;
    padding: var(--space-8) var(--page-gutter);
  }

  .filter-section {
    margin-bottom: var(--space-8);
  }

  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-lg);
    box-shadow: 0 2px 8px rgba(48, 43, 64, 0.03);
  }

  @media (min-width: 768px) {
    .filter-bar {
      flex-direction: row;
      align-items: center;
      gap: var(--space-4);
    }
  }

  .filter-label {
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: none;
    transition: all var(--motion-fast) var(--ease-soft);
  }

  .filter-chip:hover {
    background: var(--color-surface);
    border-color: var(--color-accent);
    color: var(--color-night);
    transform: translateY(-1px);
  }

  .filter-chip:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .filter-chip.active {
    background: var(--color-night);
    color: var(--color-on-dark);
    border-color: var(--color-night);
  }

  .chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold);
  }

  .chip-count {
    font-size: 0.8em;
  }

  .all-tags-link {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .all-tags-link:hover {
    color: var(--color-night);
  }

  /* Articles Grid */
  .articles-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .articles-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .articles-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .article-item {
    display: flex;
    min-width: 0;
    height: 100%;
  }

  /* Fill the column even when a card has very little text. */
  .article-item :global(.post-card) {
    width: 100%;
  }

  .articles-empty {
    display: flex;
    justify-content: center;
    padding: var(--space-12) 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .filter-chip {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
