---
/**
 * ArticleCompanion.astro
 *
 * Compact reading companion card for the article sidebar (desktop)
 * and article end (mobile).
 * - Compact mascot portrait
 * - Gold star accent
 * - Companion quotation (configurable in siteConfig.mascot)
 * - Rendered only when `siteConfig.mascot.enabled` is true
 * - Subdued, compact card styling using design tokens
 */
import { Image } from 'astro:assets';
import { siteConfig } from '../../site.config';

interface Props {
  message?: string;
  class?: string;
}

const { mascot, art } = siteConfig;
const { message = mascot.articleQuote, class: className = '' } = Astro.props;
---

{mascot.enabled && (
<aside class:list={['article-companion-card', className]} aria-label="閱讀陪伴">
  <div class="companion-header">
    <svg class="companion-star" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" fill="var(--color-gold)" />
    </svg>
    <span class="companion-title">Reading Companion</span>
  </div>

  <div class="companion-body">
    <!-- Compact mascot portrait (decorative; the quote carries the meaning) -->
    <div class="companion-portrait" aria-hidden="true">
      <Image src={art.mascot} alt="" width={60} height={80} densities={[1, 2]} format="webp" quality={75} loading="lazy" decoding="async" />
    </div>

    <!-- Companion Dialogue / Quote -->
    <div class="companion-quote-box">
      <p class="companion-quote-text">{message}</p>
      <span class="companion-curator">{mascot.articleSignature}</span>
    </div>
  </div>
</aside>
)}

<style>
  .article-companion-card {
    background-color: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .companion-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .companion-star {
    flex-shrink: 0;
  }

  .companion-title {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 650;
    color: var(--color-night);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .companion-body {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .companion-portrait {
    flex-shrink: 0;
    width: 60px;
    height: 80px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-alt);
  }

  .companion-portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .companion-quote-box {
    flex: 1 1 auto;
    min-width: 0;
  }

  .companion-quote-text {
    margin: 0 0 2px 0;
    font-size: var(--text-caption);
    color: var(--color-text);
    line-height: 1.45;
    font-style: normal;
  }

  .companion-curator {
    display: block;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-family: var(--font-body);
  }
</style>
