---
/**
 * ArticleCompanion.astro
 *
 * Compact reading companion card for the article sidebar (desktop)
 * and article end (mobile), per docs/design/page-layout-spec.md v1.2.
 * - Mascot Reading neutral placeholder (compact ~1:1 / compact slot)
 * - Gold star accent
 * - Companion quotation: 「今天也一起學到了新知識呢。」
 * - Subdued, compact card styling using design tokens
 */

interface Props {
  message?: string;
  class?: string;
}

const {
  message = "今天也一起學到了新知識呢。",
  class: className = '',
} = Astro.props;
---

<aside class:list={['article-companion-card', className]} aria-label="閱讀陪伴">
  <div class="companion-header">
    <svg class="companion-star" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" fill="var(--color-gold)" />
    </svg>
    <span class="companion-title">Reading Companion</span>
  </div>

  <div class="companion-body">
    <!-- Compact Mascot Neutral Slot -->
    <div class="companion-placeholder-icon" aria-hidden="true">
      <svg class="book-mini-icon" width="28" height="28" viewBox="0 0 48 48" fill="none">
        <rect x="8" y="10" width="32" height="28" rx="4" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1.5" />
        <path d="M24 12V36" stroke="var(--color-border)" stroke-width="1.5" stroke-dasharray="2 2" />
        <path d="M14 18H20M14 24H20M28 18H34M28 24H34" stroke="var(--color-lavender)" stroke-width="1.5" stroke-linecap="round" />
        <path d="M24 6L25.5 10L30 11.5L25.5 13L24 17L22.5 13L18 11.5L22.5 10L24 6Z" fill="var(--color-gold)" />
      </svg>
      <span class="placeholder-tag">Mascot</span>
    </div>

    <!-- Companion Dialogue / Quote -->
    <div class="companion-quote-box">
      <p class="companion-quote-text">{message}</p>
      <span class="companion-curator">— 館員 · 館員筆記</span>
    </div>
  </div>
</aside>

<style>
  .article-companion-card {
    background-color: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .companion-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .companion-star {
    flex-shrink: 0;
  }

  .companion-title {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 650;
    color: var(--color-night);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .companion-body {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .companion-placeholder-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-surface-alt) 100%);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    padding: 2px;
  }

  .placeholder-tag {
    font-size: 0.55rem;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }

  .companion-quote-box {
    flex: 1 1 auto;
    min-width: 0;
  }

  .companion-quote-text {
    margin: 0 0 2px 0;
    font-size: var(--text-caption);
    color: var(--color-text);
    line-height: 1.45;
    font-style: normal;
  }

  .companion-curator {
    display: block;
    font-size: 0.7rem;
    color: var(--color-accent);
    font-family: var(--font-body);
  }
</style>
