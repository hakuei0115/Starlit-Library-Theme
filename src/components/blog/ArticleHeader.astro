---
import { t } from '../../i18n/ui';
import { siteConfig } from '../../site.config';
import { copy } from '../../i18n/copy';
import { tagUrl } from '../../utils/tags';
interface Props {
  title: string;
  pubDate: Date | string;
  updatedDate?: Date | string;
  category: string;
  tags?: string[];
  readingTime?: string;
  description?: string;
}

const {
  title,
  pubDate,
  updatedDate,
  category,
  tags = [],
  readingTime,
  description,
} = Astro.props;

const dateObj = new Date(pubDate);
const isoDate = !isNaN(dateObj.getTime()) ? dateObj.toISOString() : '';
const displayDate = !isNaN(dateObj.getTime())
  ? new Intl.DateTimeFormat(siteConfig.lang, {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(dateObj)
  : String(pubDate);

const updatedDateObj = updatedDate ? new Date(updatedDate) : null;
const isoUpdatedDate = updatedDateObj && !isNaN(updatedDateObj.getTime()) ? updatedDateObj.toISOString() : '';
const displayUpdatedDate = updatedDateObj && !isNaN(updatedDateObj.getTime())
  ? new Intl.DateTimeFormat(siteConfig.lang, {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(updatedDateObj)
  : '';
---

<header class="article-header">
  <nav class="article-breadcrumb" aria-label={t.common.breadcrumb}>
    <ol class="breadcrumb-list">
      <li class="breadcrumb-item">
        <a href="/" class="breadcrumb-link">{t.common.home}</a>
      </li>
      <li class="breadcrumb-separator" aria-hidden="true">/</li>
      <li class="breadcrumb-item">
        <a href="/articles" class="breadcrumb-link">{copy.articles.title}</a>
      </li>
      <li class="breadcrumb-separator" aria-hidden="true">/</li>
      <li class="breadcrumb-item breadcrumb-current" aria-current="page">
        {category}
      </li>
    </ol>
  </nav>

  <div class="article-header__badge-wrap">
    <span class="article-category-badge">{category}</span>
  </div>

  <h1 class="article-title">{title}</h1>

  {description && (
    <p class="article-lead">{description}</p>
  )}

  <div class="article-meta">
    <div class="article-meta-group">
      {displayDate && (
        <time datetime={isoDate} class="meta-item">
          <svg class="meta-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>{t.post.published(displayDate)}</span>
        </time>
      )}

      {displayUpdatedDate && (
        <time datetime={isoUpdatedDate} class="meta-item meta-item--updated">
          <svg class="meta-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          <span>{t.post.updated(displayUpdatedDate)}</span>
        </time>
      )}

      {readingTime && (
        <span class="meta-item">
          <svg class="meta-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>{readingTime}</span>
        </span>
      )}
    </div>

    {tags.length > 0 && (
      <div class="article-tags-wrap" aria-label={t.common.articleTags}>
        <ul class="article-tags-list">
          {tags.map((tag) => (
            <li class="article-tag-item">
              <a href={tagUrl(tag)} class="article-tag">#{tag}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</header>

<style>
  .article-header {
    margin-bottom: var(--space-8, 2rem);
    padding-bottom: var(--space-6, 1.5rem);
    border-bottom: 1px solid var(--color-border, #e2d8e3);
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4, 1rem) 0;
    font-size: var(--text-small, 0.875rem);
    color: var(--color-text-muted, #716a7b);
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
  }

  .breadcrumb-link {
    color: var(--color-text-muted, #716a7b);
    text-decoration: none;
    transition: color var(--motion-fast, 140ms) ease;
  }

  .breadcrumb-link:hover {
    color: var(--color-night, #302b40);
    text-decoration: underline;
  }

  .breadcrumb-separator {
    color: var(--color-lavender, #c8c8d7);
    font-size: 0.8rem;
    user-select: none;
  }

  .breadcrumb-current {
    color: var(--color-text, #524b5a);
    font-weight: 500;
  }

  .article-header__badge-wrap {
    margin-bottom: var(--space-3, 0.75rem);
  }

  .article-category-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.8rem;
    font-size: var(--text-small, 0.8125rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-night, #302b40);
    background-color: var(--color-surface-alt, #edeaf6);
    border: 1px solid var(--color-border, #e2d8e3);
    border-radius: var(--radius-pill, 9999px);
  }

  .article-title {
    font-size: var(--text-h1, clamp(2rem, 3.1vw, 3rem));
    font-weight: 650;
    line-height: 1.25;
    color: var(--color-text, #524b5a);
    margin: 0 0 var(--space-4, 1rem) 0;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .article-lead {
    font-size: var(--text-article, 1.0625rem);
    line-height: 1.8;
    color: var(--color-text-muted, #716a7b);
    margin: 0 0 var(--space-6, 1.5rem) 0;
    max-width: var(--container-prose, 736px);
  }

  .article-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
  }

  .article-meta-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4, 1rem);
    font-size: var(--text-small, 0.875rem);
    color: var(--color-text-muted, #716a7b);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-icon {
    flex-shrink: 0;
    opacity: 0.75;
  }

  .article-tags-wrap {
    margin-top: 0.25rem;
  }

  .article-tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-tag-item {
    display: inline-flex;
  }

  .article-tag {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-caption, 0.75rem);
    color: var(--color-text-muted, #716a7b);
    background-color: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e2d8e3);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm, 0.375rem);
    text-decoration: none;
  }

  .article-tag:hover {
    color: var(--color-night);
    border-color: var(--color-accent);
  }
</style>
