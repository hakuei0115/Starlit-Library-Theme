---
import { t } from '../../i18n/ui';
import { siteConfig } from '../../site.config';
import { currentYear } from '../../utils/date';
import { copy } from '../../i18n/copy';
import { footerSky } from '../../utils/starry-sky';

const { links, footer, appearance } = siteConfig;
---

<footer class:list={['site-footer', { 'site-footer--sky': appearance.starrySky }]}>
  <!-- Subtle Starlit Divider with Gold Star Accent -->
  <div class="footer-divider-container container-site" aria-hidden="true">
    <div class="footer-divider-line"></div>
    <div class="footer-divider-star">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" fill="var(--color-gold)" />
      </svg>
    </div>
    <div class="footer-divider-line"></div>
  </div>

  <div class="footer-content container-site">
    <div class="footer-main">
      <div class="footer-brand">
        <div class="footer-brand-title">{siteConfig.title}</div>
        {footer.tagline && <p class="footer-tagline">{footer.tagline}</p>}
      </div>

      <nav class="footer-nav" aria-label={t.footer.nav}>
        <div class="footer-nav-col">
          <h2 class="footer-heading">{t.footer.navigation}</h2>
          <ul class="footer-links">
            {copy.nav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>

        {(links.rss || links.github) && (
        <div class="footer-nav-col">
          <h2 class="footer-heading">{t.footer.resources}</h2>
          <ul class="footer-links">
            {links.rss && <li><a href="/rss.xml">{t.footer.rss}</a></li>}
            {links.github && <li><a href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>}
          </ul>
        </div>
        )}
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear()} {siteConfig.author}. {t.footer.rights}
      </p>
      {footer.note && <p class="footer-companion-note">{footer.note}</p>}
    </div>
  </div>

  {appearance.starrySky && <div class="footer-sky-slot" aria-hidden="true" set:html={footerSky()} />}
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-top: var(--space-3);
    padding-bottom: var(--space-12);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .site-footer--sky {
    padding-bottom: var(--space-4);
  }

  .footer-sky-slot :global(.footer-sky) {
    display: block;
    width: min(100%, 106rem);
    aspect-ratio: 1600 / 180;
    margin: var(--space-4) auto 0;
  }

  @media print {
    .footer-sky-slot {
      display: none;
    }
  }

  /* Celestial Divider */
  .footer-divider-container {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .footer-divider-line {
    flex: 1;
    height: 1px;
    background-color: var(--color-border);
  }

  .footer-divider-star {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
  }

  /* Main Footer Layout */
  .footer-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .footer-main {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .footer-brand {
    max-width: 24rem;
  }

  .footer-brand-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 650;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .footer-tagline {
    margin: 0;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .footer-nav {
    display: flex;
    gap: var(--space-10);
  }

  .footer-nav-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    margin: 0;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* 44px-tall touch targets; the spacing between links now comes from the target itself. */
  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-soft);
  }

  .footer-links a:hover {
    color: var(--color-night);
    text-decoration: underline;
  }

  /* Bottom Row */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-6);
    font-size: var(--text-caption);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .copyright,
  .footer-companion-note {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
