---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Subtle Starlit Divider with Gold Star Accent -->
  <div class="footer-divider-container container-site" aria-hidden="true">
    <div class="footer-divider-line"></div>
    <div class="footer-divider-star">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" fill="var(--color-gold)" />
      </svg>
    </div>
    <div class="footer-divider-line"></div>
  </div>

  <div class="footer-content container-site">
    <div class="footer-main">
      <div class="footer-brand">
        <div class="footer-brand-title">Mascot's Library</div>
        <p class="footer-tagline">一座星空中的溫柔技術圖書館，館員安靜陪伴讀者閱讀與探索技術。</p>
      </div>

      <nav class="footer-nav" aria-label="頁尾連結">
        <div class="footer-nav-col">
          <h2 class="footer-heading">導覽</h2>
          <ul class="footer-links">
            <li><a href="/">首頁</a></li>
            <li><a href="/articles">文章</a></li>
            <li><a href="/about">關於</a></li>
          </ul>
        </div>

        <div class="footer-nav-col">
          <h2 class="footer-heading">資源</h2>
          <ul class="footer-links">
            <li><a href="/rss.xml">RSS 訂閱</a></li>
            <li><a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} Mascot's Library. All rights reserved.
      </p>
      <p class="footer-companion-note">
        Starlit Library Theme &mdash; Powered by Astro
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-top: var(--space-3);
    padding-bottom: var(--space-12);
    background-color: var(--color-bg);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  /* Celestial Divider */
  .footer-divider-container {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .footer-divider-line {
    flex: 1;
    height: 1px;
    background-color: var(--color-border);
  }

  .footer-divider-star {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
  }

  /* Main Footer Layout */
  .footer-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .footer-main {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .footer-brand {
    max-width: 24rem;
  }

  .footer-brand-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 650;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .footer-tagline {
    margin: 0;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .footer-nav {
    display: flex;
    gap: var(--space-10);
  }

  .footer-nav-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    margin: 0;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-soft);
  }

  .footer-links a:hover {
    color: var(--color-night);
    text-decoration: underline;
  }

  /* Bottom Row */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-6);
    font-size: var(--text-caption);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .copyright,
  .footer-companion-note {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
