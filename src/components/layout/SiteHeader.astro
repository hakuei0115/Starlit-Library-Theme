---
import { siteConfig } from '../../site.config';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// A nav item is active on its own page; "Articles" also covers individual posts.
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  if (href === '/articles') return currentPath.startsWith('/articles') || currentPath.startsWith('/posts');
  return currentPath.startsWith(href);
};
const navItems = siteConfig.nav.map((item) => ({ ...item, active: isActive(item.href) }));
---

<header class="site-header">
  <div class="site-header-inner container-site">
    <!-- Brand / Wordmark -->
    <a href="/" class="brand-link">
      <svg class="brand-star" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" fill="var(--color-gold)" />
      </svg>
      <span class="brand-title">{siteConfig.title}</span>
      {siteConfig.subtitle && <span class="brand-sub">{siteConfig.subtitle}</span>}
    </a>

    <!-- Desktop Navigation (>= 1024px) -->
    <nav class="desktop-nav" aria-label="主要導覽">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { 'nav-link-active': item.active }]}
              aria-current={item.active ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile Menu Toggle Button (< 1024px) -->
    <button
      id="mobile-nav-toggle"
      class="mobile-toggle-btn"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav-drawer"
      aria-label="開啟導覽選單"
    >
      <span class="sr-only">選單</span>
      <svg class="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Drawer Overlay & Panel.
     Kept outside <header>: the header's backdrop-filter would otherwise become the
     containing block for these position:fixed elements and clip them to the header box. -->
  <div id="mobile-nav-overlay" class="mobile-nav-overlay" aria-hidden="true"></div>
  <div id="mobile-nav-drawer" class="mobile-nav-drawer" role="dialog" aria-modal="true" aria-label="行動版導覽選單">
    <nav class="mobile-nav" aria-label="行動版導覽">
      <ul class="mobile-nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['mobile-nav-link', { 'mobile-nav-link-active': item.active }]}
              aria-current={item.active ? 'page' : undefined}
            >
              <span>{item.label}</span>
              <span class="mobile-link-sub">{item.sub}</span>
            </a>
          </li>
        ))}
      </ul>

      {siteConfig.mascot.enabled && siteConfig.mascot.drawerNote && (
        <div class="mobile-nav-footer">
          <div class="mobile-mascot-hint">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" fill="var(--color-gold)" />
            </svg>
            <span>{siteConfig.mascot.drawerNote}</span>
          </div>
        </div>
      )}
    </nav>
  </div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background-color: rgba(248, 247, 252, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: var(--border-thin);
    transition: background-color var(--motion-fast) var(--ease-soft);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem; /* ~64px */
    padding-block: var(--space-2);
    min-width: 0;
    width: 100%;
  }

  /* Brand Link */
  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-text);
    min-width: 0;
    flex-shrink: 1;
  }

  .brand-star {
    flex-shrink: 0;
    transition: transform var(--motion-normal) var(--ease-soft);
  }

  .brand-link:hover .brand-star {
    transform: rotate(45deg) scale(1.1);
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 650;
    color: var(--color-text);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 640px) {
    .brand-title {
      font-size: 1.25rem;
    }
  }

  .brand-sub {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-left: var(--space-1);
    display: none;
  }

  @media (min-width: 640px) {
    .brand-sub {
      display: inline;
    }
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: 500;
    border-radius: var(--radius-sm);
    transition: color var(--motion-fast) var(--ease-soft), background-color var(--motion-fast) var(--ease-soft);
    position: relative;
  }

  .nav-link:hover {
    color: var(--color-night);
    background-color: var(--color-surface-alt);
  }

  .nav-link-active {
    color: var(--color-night);
    font-weight: 650;
  }

  .nav-link-active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: var(--space-3);
    right: var(--space-3);
    height: 2px;
    background-color: var(--color-accent);
    border-radius: var(--radius-pill);
  }

  /* Mobile Toggle Button */
  .mobile-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: transparent;
    border: var(--border-thin);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    cursor: pointer;
    transition: background-color var(--motion-fast) var(--ease-soft);
    flex-shrink: 0;
    min-width: 0;
  }

  .mobile-toggle-btn:hover {
    background-color: var(--color-surface-alt);
  }

  .icon-close {
    display: none;
  }

  .mobile-toggle-btn[aria-expanded="true"] .icon-menu {
    display: none;
  }

  .mobile-toggle-btn[aria-expanded="true"] .icon-close {
    display: block;
  }

  @media (min-width: 1024px) {
    .mobile-toggle-btn {
      display: none;
    }
  }

  /* Mobile Drawer Overlay */
  .mobile-nav-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(48, 43, 64, 0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 150;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--motion-normal) var(--ease-soft), visibility var(--motion-normal);
  }

  .mobile-nav-overlay[data-open="true"] {
    opacity: 1;
    visibility: visible;
  }

  /* Mobile Drawer Panel */
  .mobile-nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(80vw, 320px);
    background-color: var(--color-bg);
    border-left: var(--border-thin);
    box-shadow: var(--shadow-floating);
    z-index: 200;
    transform: translateX(100%);
    visibility: hidden;
    transition: transform var(--motion-gentle) var(--ease-soft), visibility var(--motion-gentle);
    display: flex;
    flex-direction: column;
    padding: var(--space-8) var(--space-6);
  }

  .mobile-nav-drawer:not([data-open="true"]) {
    display: none;
  }

  .mobile-nav-drawer[data-open="true"] {
    display: flex;
    transform: translateX(0);
    visibility: visible;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mobile-nav-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: var(--space-4);
    color: var(--color-text);
    text-decoration: none;
    font-size: 1.125rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    border: var(--border-thin);
    transition: background-color var(--motion-fast) var(--ease-soft), color var(--motion-fast) var(--ease-soft);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link-active {
    background-color: var(--color-surface-alt);
    color: var(--color-night);
  }

  .mobile-link-sub {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .mobile-nav-footer {
    padding-top: var(--space-6);
    border-top: var(--border-thin);
  }

  .mobile-mascot-hint {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }
</style>

<script>
  // Publish the header height; it changes with zoom, font size and wrapping.
  function trackHeaderHeight() {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
    }).observe(header);
  }
  trackHeaderHeight();
  document.addEventListener('astro:after-swap', trackHeaderHeight);

  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    const overlay = document.getElementById('mobile-nav-overlay');

    if (!toggleBtn || !drawer || !overlay) return;

    // Everything behind the drawer is made inert while it is open.
    const setBackgroundInert = (inert: boolean) => {
      document
        .querySelectorAll<HTMLElement>('#main-content, .site-footer, .skip-to-content, .brand-link')
        .forEach((el) => (el.inert = inert));
    };

    function openMenu() {
      setBackgroundInert(true);
      toggleBtn?.setAttribute('aria-expanded', 'true');
      toggleBtn?.setAttribute('aria-label', '關閉導覽選單');
      drawer?.setAttribute('data-open', 'true');
      overlay?.setAttribute('data-open', 'true');
      document.body.style.overflow = 'hidden';
      drawer?.querySelector<HTMLElement>('a')?.focus();
    }

    function closeMenu() {
      setBackgroundInert(false);
      toggleBtn?.setAttribute('aria-expanded', 'false');
      toggleBtn?.setAttribute('aria-label', '開啟導覽選單');
      drawer?.removeAttribute('data-open');
      overlay?.removeAttribute('data-open');
      document.body.style.overflow = '';
    }

    toggleBtn.addEventListener('click', () => {
      const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    overlay.addEventListener('click', closeMenu);

    // The drawer only exists on narrow screens; close it if the window grows.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) closeMenu();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        toggleBtn.focus();
      }
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
  } else {
    setupMobileMenu();
  }
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
