---
import MascotPortrait from '../mascot/MascotPortrait.astro';

interface Props {
  greeting?: string;
  message?: string;
}

const {
  greeting = "Welcome to my Starlit Library ✦",
  message = "歡迎來到這座靜謐的技術圖書館。在漫長的思考與探索中，館員會一直陪伴你翻閱每一篇筆記，願微光能為你指引前行的方向。"
} = Astro.props;
---

<aside class="mascot-corner-card" aria-label="館員的閱讀角落">
  <!-- Section Header -->
  <div class="corner-header">
    <h2 class="corner-title">
      <span class="corner-star" aria-hidden="true">✦</span>
      <span>Mascot's Corner</span>
    </h2>
  </div>

  <div class="corner-content-box">
    <!-- Mascot Neutral Placeholder Slot -->
    <div class="corner-avatar-wrapper">
      <MascotPortrait variant="reading" size="md" />
    </div>

    <!-- Dialogue Bubble Card -->
    <div class="corner-dialogue-card">
      <div class="dialogue-header">
        <span class="dialogue-sparkle" aria-hidden="true">✦</span>
        <h3 class="dialogue-greeting">{greeting}</h3>
      </div>

      <p class="dialogue-body">{message}</p>

      <div class="dialogue-footer">
        <span class="dialogue-curator">圖書館館員</span>
      </div>
    </div>
  </div>
</aside>

<style>
  .mascot-corner-card {
    background-color: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .corner-header {
    padding-bottom: var(--space-2);
    border-bottom: 1px dashed var(--color-border);
  }

  .corner-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 650;
    color: var(--color-text);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .corner-star {
    color: var(--color-gold);
    font-size: 0.9em;
  }

  .corner-content-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .corner-avatar-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .corner-dialogue-card {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    background-color: var(--color-surface-alt);
    border: var(--border-thin);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    position: relative;
  }

  .dialogue-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dialogue-sparkle {
    color: var(--color-gold);
    font-size: 0.85em;
  }

  .dialogue-greeting {
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 650;
    color: var(--color-night);
    margin: 0;
  }

  .dialogue-body {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    line-height: 1.7;
    color: var(--color-text);
    margin: 0;
  }

  .dialogue-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-1);
    padding-top: var(--space-2);
    border-top: 1px dashed var(--color-border);
  }

  .dialogue-curator {
    font-size: 0.725rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }
</style>
