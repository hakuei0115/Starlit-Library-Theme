---
import { getCollection } from 'astro:content';

interface Props {
  categories?: string[];
  activeCategory?: string;
  showAllOption?: boolean;
  /** Mark the "all articles" chip as the current page. Only true on the articles index itself. */
  allActive?: boolean;
}

const { categories: propCategories, activeCategory, showAllOption = false, allActive = false } = Astro.props;

let displayCategories = propCategories;

if (!displayCategories) {
  try {
    const allPosts = await getCollection('blog');
    const catSet = new Set<string>();
    for (const p of allPosts) {
      if (!p.data.draft && p.data.category) {
        catSet.add(p.data.category);
      }
    }
    displayCategories = Array.from(catSet);
  } catch (err) {
    displayCategories = ['AI & LLM', 'Software Engineering', 'System Architecture', 'Dev Notes'];
  }
}
---

{displayCategories && displayCategories.length > 0 && (
  <nav class="topic-chips-container" aria-label="主題分類導覽">
    <div class="topic-label">
      <span class="star-icon" aria-hidden="true">✦</span>
      <span>典藏主題</span>
    </div>
    
    <div class="chips-list" role="list">
      {showAllOption && (
        <div class="chip-item" role="listitem">
          <a
            href="/articles"
            class:list={['topic-chip', { active: allActive && !activeCategory }]}
            aria-current={allActive && !activeCategory ? 'page' : undefined}
          >
            全部文章
          </a>
        </div>
      )}
      {displayCategories.map((cat) => {
        const isActive = activeCategory === cat;
        return (
          <div class="chip-item" role="listitem">
            <a
              href={`/articles?category=${encodeURIComponent(cat)}`}
              class:list={['topic-chip', { active: isActive }]}
              aria-current={isActive ? 'page' : undefined}
            >
              <span class="chip-dot" aria-hidden="true"></span>
              <span>{cat}</span>
            </a>
          </div>
        );
      })}
    </div>
  </nav>
)}

<style>
  .topic-chips-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }

  @media (min-width: 768px) {
    .topic-chips-container {
      flex-direction: row;
      align-items: center;
      gap: var(--space-4);
    }
  }

  .topic-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-text-muted);
    white-space: nowrap;
    letter-spacing: 0.04em;
  }

  .star-icon {
    color: var(--color-gold);
    font-size: 0.9em;
  }

  .chips-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .chip-item {
    display: inline-flex;
  }

  .topic-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: var(--border-thin);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: 500;
    transition: all var(--motion-fast) var(--ease-soft);
    box-shadow: 0 1px 4px rgba(48, 43, 64, 0.03);
  }

  .topic-chip:hover {
    background: var(--color-surface-alt);
    border-color: var(--color-accent);
    color: var(--color-night);
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(48, 43, 64, 0.07);
  }

  .topic-chip:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .topic-chip.active {
    background: var(--color-night);
    color: var(--color-on-dark);
    border-color: var(--color-night);
  }

  .topic-chip.active .chip-dot {
    background: var(--color-gold);
  }

  .chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-lavender);
    transition: background var(--motion-fast) var(--ease-soft);
  }

  .topic-chip:hover .chip-dot {
    background: var(--color-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .topic-chip {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
