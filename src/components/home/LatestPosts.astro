---
import { getCollection } from 'astro:content';

interface Props {
  limit?: number;
}

const { limit = 5 } = Astro.props;

let latestPosts: any[] = [];

try {
  const allPosts = await getCollection('blog');
  latestPosts = allPosts
    .filter(p => !p.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, limit);
} catch (err) {
  latestPosts = [];
}
---

<section class="latest-notes-section" aria-labelledby="latest-heading">
  <div class="section-header">
    <h2 id="latest-heading" class="section-title">
      <span class="book-icon" aria-hidden="true">📖</span>
      <span>Latest Notes</span>
    </h2>
    <a href="/articles" class="view-more-link">
      <span>View More</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>

  {latestPosts.length > 0 ? (
    <div class="notes-list" role="feed" aria-label="最新筆記列表">
      {latestPosts.map((post) => {
        const postUrl = `/posts/${post.id}/`;
        const pubDateObj = post.data.pubDate ? new Date(post.data.pubDate) : null;
        const displayDate = pubDateObj
          ? new Intl.DateTimeFormat('zh-TW', {
              year: 'numeric',
              month: '2-digit',
              day: '2-digit',
            }).format(pubDateObj)
          : '';
        const readingTime = post.data.readingTime || '5 min read';

        return (
          <article class="note-row-card">
            <!-- Left Thumbnail (~96x64px) -->
            <div class="note-thumbnail" aria-hidden="true">
              {post.data.heroImage ? (
                <img src={post.data.heroImage} alt="" class="thumbnail-img" loading="lazy" />
              ) : (
                <div class="thumbnail-placeholder">
                  <span class="thumbnail-symbol">✦</span>
                </div>
              )}
            </div>

            <!-- Center Content -->
            <div class="note-details">
              <div class="note-header-line">
                <span class="note-category">{post.data.category}</span>
                <span class="note-dot-sep">·</span>
                <time datetime={pubDateObj ? pubDateObj.toISOString() : ''} class="note-date">
                  {displayDate}
                </time>
              </div>

              <h3 class="note-title">
                <a href={postUrl} class="note-title-link">
                  {post.data.title}
                </a>
              </h3>

              {post.data.description && (
                <p class="note-excerpt">{post.data.description}</p>
              )}
            </div>
          </article>
        );
      })}
    </div>
  ) : (
    <div class="notes-empty">
      <p>目前尚無新發布的文章筆記。</p>
    </div>
  )}
</section>

<style>
  .latest-notes-section {
    width: 100%;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-thin);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 650;
    color: var(--color-text);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .book-icon {
    font-size: 1em;
  }

  .view-more-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-soft);
  }

  .view-more-link:hover {
    color: var(--color-night);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .view-more-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* Compact Horizontal List */
  .notes-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .note-row-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    background-color: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    box-shadow: 0 2px 8px rgba(48, 43, 64, 0.03);
    transition: transform var(--motion-fast) var(--ease-soft),
                box-shadow var(--motion-fast) var(--ease-soft),
                border-color var(--motion-fast) var(--ease-soft);
  }

  .note-row-card:hover {
    transform: translateX(2px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-accent);
  }

  /* Thumbnail: ~96x64px */
  .note-thumbnail {
    flex-shrink: 0;
    width: 88px;
    height: 60px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: linear-gradient(135deg, #302B40 0%, #453D57 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .note-thumbnail {
      width: 96px;
      height: 64px;
    }
  }

  .thumbnail-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnail-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .thumbnail-symbol {
    color: var(--color-gold);
    font-size: 1.1rem;
    opacity: 0.8;
  }

  /* Note Details */
  .note-details {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1 1 0%;
    gap: 2px;
  }

  .note-header-line {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  .note-category {
    font-weight: 550;
    color: var(--color-text);
  }

  .note-dot-sep {
    color: var(--color-lavender);
  }

  .note-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.35;
    margin: 2px 0 3px 0;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .note-title-link {
    color: inherit;
    text-decoration: none;
  }

  .note-title-link:hover {
    color: var(--color-night);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 3px;
  }

  .note-title-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .note-excerpt {
    font-size: var(--text-caption);
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .notes-empty {
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .note-row-card {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
