---
import { t } from '../../i18n/ui';
import { formatDate } from '../../utils/date';
import CoverImage from '../common/CoverImage.astro';
import { getPublishedPosts, selectFeatured, formatReadingTime } from '../../utils/posts';

const featuredPosts = selectFeatured(await getPublishedPosts());

// Layout by width (see the styles below):
//   <768px       swipeable row, one card at a time
//   768–899px    with 3 posts: a wide lead card above two stacked cards
//   900–1279px   with 3 posts: a wide lead card above two short horizontal cards
//   >=1280px     with 3 posts: three equal columns
// Two posts are always equal cards; a single post is a wide card from 768px.
const count = featuredPosts.length;
---

<section class="featured-posts-section" aria-labelledby="featured-heading">
  <div class="section-header">
    <div class="header-titles">
      <h2 id="featured-heading" class="section-title">
        <span class="star-icon" aria-hidden="true">✦</span>
        <span>{t.home.featured}</span>
      </h2>
    </div>
    <a href="/articles" class="view-all-link">
      <span>{t.common.viewAll}</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>

  {featuredPosts.length > 0 ? (
    <div class:list={['featured-grid', `featured-grid--${count}`]}>
      {featuredPosts.map((post, index) => {
        const postUrl = `/posts/${post.id}/`;
        const pubDateObj = post.data.pubDate ? new Date(post.data.pubDate) : null;
        const displayDate = pubDateObj
          ? formatDate(pubDateObj)
          : '';
        const readingTime = formatReadingTime(post.body);
        const isLead = count !== 2 && index === 0;

        return (
          <article class="featured-card">
            <!-- Top Cover Slot -->
            <div class="card-cover">
              <CoverImage post={post} variant={isLead ? 'lead' : 'card'} class="cover-img" />
            </div>

            <!-- Card Content Body -->
            <div class="card-body">
              <div class="card-meta-top">
                <span class="card-category">{post.data.category}</span>
                <span class="card-star" aria-hidden="true">✦</span>
              </div>

              <h3 class="card-title">
                <a href={postUrl} class="card-title-link">
                  {post.data.title}
                </a>
              </h3>

              {post.data.description && (
                <p class="card-excerpt">{post.data.description}</p>
              )}

              <div class="card-meta-bottom">
                {displayDate && (
                  <span class="meta-date">
                    <svg class="meta-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    {displayDate}
                  </span>
                )}
                {displayDate && readingTime && <span class="meta-separator" aria-hidden="true">·</span>}
                {readingTime && (
                  <span class="meta-reading-time">
                    <svg class="meta-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    {readingTime}
                  </span>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  ) : (
    <div class="featured-empty">
      <p>{t.home.featuredEmpty}</p>
    </div>
  )}

  {count > 1 && (
    <div class="featured-dots" hidden>
      {featuredPosts.map((post, index) => (
        <button
          type="button"
          class="featured-dot"
          aria-label={t.home.showFeatured(index + 1, post.data.title)}
          aria-current={index === 0 ? 'true' : undefined}
        />
      ))}
    </div>
  )}
</section>

<script>
  // Swiping works with CSS alone; this keeps the dots in step and lets them be pressed.
  function setupFeaturedCarousel() {
    const grid = document.querySelector<HTMLElement>('.featured-grid');
    const dotList = document.querySelector<HTMLElement>('.featured-dots');
    if (!grid || !dotList) return;

    const cards = [...grid.querySelectorAll<HTMLElement>('.featured-card')];
    const dots = [...dotList.querySelectorAll<HTMLButtonElement>('.featured-dot')];

    // Scroll position that shows a card; the last one stops at the end of the row.
    const target = (card: HTMLElement) =>
      Math.min(card.offsetLeft - cards[0].offsetLeft, grid.scrollWidth - grid.clientWidth);

    const show = (index: number) => {
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      grid.scrollTo({ left: target(cards[index]), behavior: calm ? 'auto' : 'smooth' });
    };

    const update = () => {
      const distances = cards.map((card) => Math.abs(target(card) - grid.scrollLeft));
      const current = distances.indexOf(Math.min(...distances));
      dots.forEach((dot, i) => {
        if (i === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
    // A keyboard user tabbing into a half-visible card gets the whole card.
    cards.forEach((card, i) => card.addEventListener('focusin', () => {
      if (grid.scrollWidth > grid.clientWidth) show(i);
    }));
    grid.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });

    dotList.hidden = false;
  }

  setupFeaturedCarousel();
  document.addEventListener('astro:after-swap', setupFeaturedCarousel);
</script>

<style>
  .featured-posts-section {
    width: 100%;
    margin-block: var(--space-4) var(--space-8);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-thin);
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .header-titles {
    display: flex;
    align-items: center;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 4.5vw, var(--text-h2));
    font-weight: 650;
    color: var(--color-text);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    letter-spacing: -0.01em;
  }

  .star-icon {
    color: var(--color-gold);
    font-size: 0.9em;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-soft);
  }

  .view-all-link:hover {
    color: var(--color-night);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .view-all-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* Card styling aligning with design mockups */
  .featured-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    background-color: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: transform var(--motion-normal) var(--ease-soft),
                box-shadow var(--motion-normal) var(--ease-soft),
                border-color var(--motion-normal) var(--ease-soft);
    height: 100%;
  }

  .featured-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-accent);
  }

  /* Cover Slot */
  .card-cover {
    width: 100%;
    aspect-ratio: 2 / 1;
    background: linear-gradient(135deg, #2D273B 0%, #3B334D 60%, #4D4464 100%);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* The <img> is rendered by CoverImage, so it needs :global to pick up this scope. */
  .card-cover :global(.cover-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Card Body */
  .card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .card-category {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.65rem;
    font-size: var(--text-caption);
    font-weight: 550;
    color: var(--color-night);
    background-color: var(--color-surface-alt);
    border-radius: var(--radius-pill);
    letter-spacing: 0.02em;
  }

  .card-star {
    color: var(--color-gold);
    font-size: 0.9em;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 650;
    line-height: 1.35;
    margin: 0 0 var(--space-2) 0;
    color: var(--color-text);
    text-wrap: balance;
  }

  .card-title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-soft);
  }

  .card-title-link:hover {
    color: var(--color-night);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 4px;
  }

  /* Stretched link: the whole card is the click target, not just the title. */
  .card-title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-title-link:focus-visible {
    outline: none;
  }

  .card-title-link:focus-visible::after {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
    border-radius: var(--radius-lg);
  }

  .card-excerpt {
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4) 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .card-meta-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-border);
  }

  .meta-date, .meta-reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .meta-icon {
    flex-shrink: 0;
    opacity: 0.75;
  }

  .meta-separator {
    color: var(--color-lavender);
  }

  .featured-empty {
    padding: var(--space-8);
    background: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-lg);
    text-align: center;
    color: var(--color-text-muted);
  }

  /* Narrow screens: a swipeable row, with part of the next card showing. */
  .featured-grid {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* Room for the card's hover lift inside the scrolling box. */
    padding-block: var(--space-1);
  }

  .featured-grid::-webkit-scrollbar {
    display: none;
  }

  .featured-grid > .featured-card {
    flex: 0 0 86%;
    height: auto;
    scroll-snap-align: start;
  }

  .featured-grid > .featured-card:last-child {
    scroll-snap-align: end;
  }

  .featured-grid--1 > .featured-card {
    flex-basis: 100%;
  }

  .featured-dots {
    display: flex;
    justify-content: center;
    margin-top: var(--space-2);
  }

  .featured-dots[hidden] {
    display: none;
  }

  /* A small dot inside a comfortably sized button. */
  .featured-dot {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2rem;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .featured-dot::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
  }

  .featured-dot[aria-current='true']::before {
    background: var(--color-night);
    border-color: var(--color-night);
  }

  @media (min-width: 768px) {
    .featured-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
      overflow: visible;
      padding-block: 0;
    }

    .featured-grid--1 {
      grid-template-columns: minmax(0, 1fr);
    }

    .featured-grid > .featured-card {
      height: 100%;
    }

    .featured-dots,
    .featured-dots:not([hidden]) {
      display: none;
    }

    /* A single post: cover and text side by side. */
    .featured-grid--1 > .featured-card {
      flex-direction: row;
    }

    .featured-grid--1 .card-cover {
      width: 46%;
      aspect-ratio: auto;
      min-height: 15rem;
      flex-shrink: 0;
    }

    .featured-grid--1 .card-body {
      justify-content: center;
      padding: var(--space-8);
    }
  }

  @media (min-width: 768px) and (max-width: 1279.98px) {
    /* Lead card: spans the row, so the first featured post reads as the one to start with. */
    .featured-grid--3 > .featured-card:first-child {
      grid-column: 1 / -1;
      flex-direction: row;
    }

    .featured-grid--3 > .featured-card:first-child .card-cover {
      width: 46%;
      aspect-ratio: auto;
      min-height: 15rem;
      flex-shrink: 0;
    }

    .featured-grid--3 > .featured-card:first-child .card-body {
      justify-content: center;
      padding: var(--space-8);
    }

    .featured-grid--3 > .featured-card:first-child .card-title {
      font-size: var(--text-h2);
      margin-bottom: var(--space-3);
    }

    .featured-grid--3 > .featured-card:first-child .card-excerpt {
      font-size: var(--text-body);
      -webkit-line-clamp: 3;
      flex-grow: 0;
    }

    .featured-grid--3 > .featured-card:first-child .card-meta-bottom {
      margin-top: var(--space-4);
    }

    /* The other two: compact cards without the excerpt. */
    .featured-grid--3 > .featured-card:not(:first-child) .card-body {
      padding: var(--space-4);
    }

    .featured-grid--3 > .featured-card:not(:first-child) .card-title {
      font-size: var(--text-article);
    }

    .featured-grid--3 > .featured-card:not(:first-child) .card-excerpt {
      display: none;
    }
  }

  /* Wide enough for the compact cards to put the cover beside the text. */
  @media (min-width: 900px) and (max-width: 1279.98px) {
    .featured-grid--3 > .featured-card:not(:first-child) {
      flex-direction: row;
    }

    .featured-grid--3 > .featured-card:not(:first-child) .card-cover {
      width: 34%;
      aspect-ratio: auto;
      flex-shrink: 0;
    }

    /* Out of flow, so the text decides the card height rather than the image. */
    .featured-grid--3 > .featured-card:not(:first-child) .card-cover :global(.cover-img) {
      position: absolute;
      inset: 0;
    }

    .featured-grid--3 > .featured-card:not(:first-child) .card-body {
      flex: 1 1 0;
    }
  }

  @media (min-width: 1280px) {
    .featured-grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-card {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
