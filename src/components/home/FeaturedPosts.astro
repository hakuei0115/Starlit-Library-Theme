---
import { siteConfig } from '../../site.config';
import CoverImage from '../common/CoverImage.astro';
import { getPublishedPosts, selectFeatured, formatReadingTime } from '../../utils/posts';

const featuredPosts = selectFeatured(await getPublishedPosts());

// With 1 or 3 posts the first one leads as a wide card; with exactly 2, two equal cards.
const hasLead = featuredPosts.length !== 2;
---

<section class="featured-posts-section" aria-labelledby="featured-heading">
  <div class="section-header">
    <div class="header-titles">
      <h2 id="featured-heading" class="section-title">
        <span class="star-icon" aria-hidden="true">✦</span>
        <span>精選文章</span>
      </h2>
    </div>
    <a href="/articles" class="view-all-link">
      <span>查看全部</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>

  {featuredPosts.length > 0 ? (
    <div class="featured-grid">
      {featuredPosts.map((post, index) => {
        const postUrl = `/posts/${post.id}/`;
        const pubDateObj = post.data.pubDate ? new Date(post.data.pubDate) : null;
        const displayDate = pubDateObj
          ? new Intl.DateTimeFormat(siteConfig.lang, {
              year: 'numeric',
              month: '2-digit',
              day: '2-digit',
            }).format(pubDateObj)
          : '';
        const readingTime = formatReadingTime(post.body);
        const isLead = hasLead && index === 0;

        return (
          <article class:list={['featured-card', { 'featured-card--lead': isLead }]}>
            <!-- Top Cover Slot -->
            <div class="card-cover">
              <CoverImage post={post} variant={isLead ? 'lead' : 'card'} class="cover-img" />
            </div>

            <!-- Card Content Body -->
            <div class="card-body">
              <div class="card-meta-top">
                <span class="card-category">{post.data.category}</span>
                <span class="card-star" aria-hidden="true">✦</span>
              </div>

              <h3 class="card-title">
                <a href={postUrl} class="card-title-link">
                  {post.data.title}
                </a>
              </h3>

              {post.data.description && (
                <p class="card-excerpt">{post.data.description}</p>
              )}

              <div class="card-meta-bottom">
                {displayDate && (
                  <span class="meta-date">
                    <svg class="meta-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    {displayDate}
                  </span>
                )}
                {displayDate && readingTime && <span class="meta-separator" aria-hidden="true">·</span>}
                {readingTime && (
                  <span class="meta-reading-time">
                    <svg class="meta-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    {readingTime}
                  </span>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  ) : (
    <div class="featured-empty">
      <p>目前尚無精選文章，書架上的典藏仍在整理中……</p>
    </div>
  )}
</section>

<style>
  .featured-posts-section {
    width: 100%;
    margin-block: var(--space-4) var(--space-8);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-thin);
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .header-titles {
    display: flex;
    align-items: center;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 4.5vw, var(--text-h2));
    font-weight: 650;
    color: var(--color-text);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    letter-spacing: -0.01em;
  }

  .star-icon {
    color: var(--color-gold);
    font-size: 0.9em;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-soft);
  }

  .view-all-link:hover {
    color: var(--color-night);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .view-all-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* Responsive grid per spec 3.5 & design-tokens.md:
     1 column <768px
     2 columns 768px - 1279px
     3 columns >=1280px
  */
  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* The lead card spans the full row and lays cover and text side by side,
     so the first featured post reads as the one to start with. */
  @media (min-width: 768px) {
    .featured-grid .featured-card--lead {
      grid-column: 1 / -1;
      flex-direction: row;
    }

    .featured-grid .featured-card--lead .card-cover {
      width: 46%;
      height: auto;
      min-height: 15rem;
      flex-shrink: 0;
    }

    .featured-grid .featured-card--lead .card-body {
      padding: var(--space-8);
      justify-content: center;
    }

    .featured-grid .featured-card--lead .card-title {
      font-size: var(--text-h2);
      margin-bottom: var(--space-3);
      text-wrap: balance;
    }

    .featured-grid .featured-card--lead .card-excerpt {
      font-size: var(--text-body);
      -webkit-line-clamp: 3;
      flex-grow: 0;
    }

    .featured-grid .featured-card--lead .card-meta-bottom {
      margin-top: var(--space-4);
    }
  }

  /* Card styling aligning with design mockups */
  .featured-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    background-color: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: transform var(--motion-normal) var(--ease-soft),
                box-shadow var(--motion-normal) var(--ease-soft),
                border-color var(--motion-normal) var(--ease-soft);
    height: 100%;
  }

  .featured-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-accent);
  }

  /* Cover Slot */
  .card-cover {
    width: 100%;
    height: 140px;
    background: linear-gradient(135deg, #2D273B 0%, #3B334D 60%, #4D4464 100%);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* The <img> is rendered by CoverImage, so it needs :global to pick up this scope. */
  .card-cover :global(.cover-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Regular cards: cover keeps a fixed ratio (first test value: 2:1). The lead card is unchanged. */
  .featured-grid {
    --card-cover-ratio: 2 / 1;
  }

  .featured-card:not(.featured-card--lead) .card-cover {
    height: auto;
    aspect-ratio: var(--card-cover-ratio);
  }


  /* Card Body */
  .card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .card-category {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.65rem;
    font-size: var(--text-caption);
    font-weight: 550;
    color: var(--color-night);
    background-color: var(--color-surface-alt);
    border-radius: var(--radius-pill);
    letter-spacing: 0.02em;
  }

  .card-star {
    color: var(--color-gold);
    font-size: 0.9em;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 650;
    line-height: 1.35;
    margin: 0 0 var(--space-2) 0;
    color: var(--color-text);
    text-wrap: balance;
  }

  .card-title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-soft);
  }

  .card-title-link:hover {
    color: var(--color-night);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 4px;
  }

  /* Stretched link: the whole card is the click target, not just the title. */
  .card-title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-title-link:focus-visible {
    outline: none;
  }

  .card-title-link:focus-visible::after {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
    border-radius: var(--radius-lg);
  }

  .card-excerpt {
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4) 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .card-meta-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-border);
  }

  .meta-date, .meta-reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .meta-icon {
    flex-shrink: 0;
    opacity: 0.75;
  }

  .meta-separator {
    color: var(--color-lavender);
  }

  .featured-empty {
    padding: var(--space-8);
    background: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-lg);
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-card {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
