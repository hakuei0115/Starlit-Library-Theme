---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import ArticleHeader from '../../components/blog/ArticleHeader.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import ArticleFooter from '../../components/blog/ArticleFooter.astro';
import ArticleCompanion from '../../components/blog/ArticleCompanion.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const publishedPosts = allPosts
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return publishedPosts.map((post, index) => {
    // Chronological navigation: Newer post is next, older is prev
    const prevPost = index < publishedPosts.length - 1 ? publishedPosts[index + 1] : null;
    const nextPost = index > 0 ? publishedPosts[index - 1] : null;

    return {
      params: { slug: post.id },
      props: { post, prevPost, nextPost },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  category={post.data.category}
  tags={post.data.tags}
  cover={post.data.heroImage}
  headings={headings}
>
  <!-- 1. Article Header -->
  <ArticleHeader
    slot="header"
    title={post.data.title}
    pubDate={post.data.pubDate}
    updatedDate={post.data.updatedDate}
    category={post.data.category}
    tags={post.data.tags}
    description={post.data.description}
  />

  <!-- 2. Mobile Collapsible TOC (< 1024px, before prose) -->
  <TableOfContents slot="toc-mobile" headings={headings} mode="mobile" />

  <!-- 3. Desktop Sidebar Top Card: TOC (>= 1024px) -->
  <TableOfContents slot="toc" headings={headings} mode="desktop" />

  <!-- 4. Desktop Sidebar Bottom Card: Docked Companion (>= 1024px) -->
  <ArticleCompanion slot="sidebar-companion" />

  <!-- 5. Main Prose Content (default slot) -->
  <Content />

  <!-- 6. Article Footer (Tags and Prev/Next Navigation) -->
  <ArticleFooter
    slot="footer"
    tags={post.data.tags}
    prevPost={prevPost}
    nextPost={nextPost}
  />

  <!-- 7. Mobile Companion (< 1024px, after footer) -->
  <ArticleCompanion slot="companion-mobile" />
</BlogPostLayout>
