---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import TopicChips from '../components/home/TopicChips.astro';
import FeaturedPosts from '../components/home/FeaturedPosts.astro';
import LatestPosts from '../components/home/LatestPosts.astro';
import MascotCorner from '../components/home/MascotCorner.astro';
import { siteConfig } from '../site.config';

const showCorner = siteConfig.mascot.enabled;
---

<BaseLayout description={siteConfig.description}>
  <div class="homepage-flow">
    <!-- 1. Full-Width Hero Banner -->
    <HomeHero />

    <!-- 2. Topic Discovery Chips -->
    <section class="home-section topics-section">
      <div class="container-site">
        <TopicChips showAllOption={true} />
      </div>
    </section>

    <!-- 3. Full-Width Featured Articles Region -->
    <div class="home-section featured-section">
      <div class="container-site">
        <FeaturedPosts />
      </div>
    </div>

    <!-- 4. Lower Region (>=1024px: Latest Notes Left, mascot corner Right when enabled) -->
    <section class="home-section lower-grid-section" aria-label={showCorner ? `最新筆記與${siteConfig.mascot.cornerTitle}` : '最新筆記'}>
      <div class="container-site">
        <div class:list={['lower-grid', { 'lower-grid--solo': !showCorner }]}>
          <div class="lower-grid__latest">
            <LatestPosts limit={5} />
          </div>
          {showCorner && (
            <div class="lower-grid__corner">
              <MascotCorner />
            </div>
          )}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .homepage-flow {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding-bottom: 0;
  }

  .home-section {
    width: 100%;
    padding: var(--space-2) 0;
  }

  .topics-section {
    padding-top: 0;
    padding-bottom: var(--space-2);
  }

  .featured-section {
    padding-top: var(--space-2);
    padding-bottom: var(--space-4);
  }

  .lower-grid-section {
    padding-top: var(--space-4);
    padding-bottom: var(--space-2);
  }

  /* Responsive Lower Grid:
     >=1024px: Left Latest Notes (~62%), Right mascot corner (~38%)
     <1024px: Stacked in order (Latest first, Corner second)
  */
  .lower-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .lower-grid:not(.lower-grid--solo) {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .lower-grid__latest {
    width: 100%;
    min-width: 0;
  }

  .lower-grid__corner {
    width: 100%;
    min-width: 0;
  }
</style>
