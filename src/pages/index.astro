---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import TopicChips from '../components/home/TopicChips.astro';
import FeaturedPosts from '../components/home/FeaturedPosts.astro';
import LatestPosts from '../components/home/LatestPosts.astro';
import MascotCorner from '../components/home/MascotCorner.astro';
---

<BaseLayout
  title="Mascot's Library — 星空技術圖書館"
  description="一座星空中的溫柔技術圖書館，館員安靜陪伴讀者閱讀 AI、程式設計與軟體架構研究筆記。"
>
  <div class="homepage-flow">
    <!-- 1. Full-Width Hero Banner (Artwork by Mascot Art Studio) -->
    <HomeHero />

    <!-- 2. Topic Discovery Chips -->
    <section class="home-section topics-section" aria-label="主題分類導覽">
      <div class="container-site">
        <TopicChips showAllOption={true} />
      </div>
    </section>

    <!-- 3. Full-Width Featured Articles Region -->
    <section class="home-section featured-section" aria-label="精選文章">
      <div class="container-site">
        <FeaturedPosts />
      </div>
    </section>

    <!-- 4. Lower Two-Column Region (>=1024px: Latest Notes Left, Mascot Corner Right) -->
    <section class="home-section lower-grid-section" aria-label="最新筆記與館員角落">
      <div class="container-site">
        <div class="lower-grid">
          <div class="lower-grid__latest">
            <LatestPosts limit={5} />
          </div>
          <div class="lower-grid__corner">
            <MascotCorner />
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .homepage-flow {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding-bottom: 0;
  }

  .home-section {
    width: 100%;
    padding: var(--space-2) 0;
  }

  .topics-section {
    padding-top: 0;
    padding-bottom: var(--space-2);
  }

  .featured-section {
    padding-top: var(--space-2);
    padding-bottom: var(--space-4);
  }

  .lower-grid-section {
    padding-top: var(--space-4);
    padding-bottom: var(--space-2);
  }

  /* Responsive Lower Grid:
     >=1024px: Left Latest Notes (~62%), Right Mascot Corner (~38%)
     <1024px: Stacked in order (Latest first, Corner second)
  */
  .lower-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .lower-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .lower-grid__latest {
    width: 100%;
    min-width: 0;
  }

  .lower-grid__corner {
    width: 100%;
    min-width: 0;
  }
</style>
